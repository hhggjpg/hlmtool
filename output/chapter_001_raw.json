      "乙": "贾雨村",
      "关系类型": "邀饮",
      "原文依据": "自己步月至庙中来邀雨村。"
    },
    {
      "甲": "甄士隐",
      "乙": "贾雨村",
      "关系类型": "资助",
      "原文依据": "当下即命小童进去速封五十两白银并两套冬衣"
