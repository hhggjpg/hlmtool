    },
    {
      "甲": "警幻仙子",
      "乙": "神瑛侍者",
      "关系类型": "留于赤霞宫并命名",
      "原文依据": "那仙子知他有些来历，因留他在赤霞宫中，名他为赤霞宫神瑛侍者。"
    },
    {
      "甲": "神瑛侍者",
      "乙": "绛珠仙草",
      "关系类型": "灌溉/还泪",
      "原文依据": "只因尚未酬报灌溉之德，故甚至五内郁结着一段缠绵不尽之意。"
    },
    {
      "甲": "石头",
      "乙": "神瑛侍者",
      "关系类型": "同一（石头被名神瑛侍者）",
      "原文依据": "一日来到警幻仙子处，那仙子知他有些来历，因留他在赤霞宫中，名他为赤霞宫神瑛侍者。"
    },
