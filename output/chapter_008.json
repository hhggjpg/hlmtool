  "关系": [
    {
      "甲": "宝玉",
      "乙": "李嬷嬷",
      "关系类型": "奶母",
      "原文依据": "宝玉的奶母李嬷嬷便说道：“天又下雪，也要看时候儿，就在这里和姐姐妹妹一处玩玩儿罢。姨太太那里摆茶呢。我叫丫头去取了斗篷来，说给小么儿们散了罢？”"
    },
    {
      "甲": "宝钗",
      "乙": "莺儿",
      "关系类型": "主仆（丫鬟）",
      "原文依据": "即令莺儿：“倒茶来。”"
    },
    {
      "甲": "黛玉",
      "乙": "雪雁",
      "关系类型": "主仆（丫鬟）",
      "原文依据": "可巧黛玉的丫鬟雪雁走来给黛玉送小手炉儿"
    },
    {
      "甲": "黛玉",
      "乙": "紫鹃",
      "关系类型": "主仆（丫鬟）",
      "原文依据": "雪雁道：“紫鹃姐姐怕姑娘冷，叫我送来的。”"
    },
    {
      "甲": "宝玉",
      "乙": "秦钟",
      "关系类型": "朋友（伴读）",
      "原文依据": "宝玉便回明贾母要约秦钟上家塾之事，自己也有个伴读的朋友，正好发奋"
    },
    {
      "甲": "秦钟",
      "乙": "秦邦业",
      "关系类型": "父子",
      "原文依据": "秦钟一一的答应，回家禀知他父亲。他父亲秦邦业现任营缮司郎中"
    },
    {
      "甲": "秦邦业",
      "乙": "秦氏",
      "关系类型": "父女",
      "原文依据": "他父亲秦邦业现任营缮司郎中，年近七旬，夫人早亡，因年至五旬时尚无儿女，便向养生堂抱了一个儿子和一个女儿。谁知儿子又死了，只剩下个女儿，小名叫做可儿，又起个官名叫做兼美。"
    },
    {
      "甲": "秦钟",
      "乙": "贾代儒",
      "关系类型": "师生（司塾）",
      "原文依据": "又知贾家塾中司塾的乃现今之老儒贾代儒，秦钟此去，可望学业进益"
    },
    {
      "甲": "秦钟",
      "乙": "宝玉",
      "关系类型": "叔侄（宝二叔）",
      "原文依据": "又嘱咐他道：“你家住的远，或一时冷热不便，只管住在我们这里。只和你宝二叔在一处，别跟着那不长进的东西们学。”"
    },
    {
      "甲": "宝玉",
      "乙": "秦钟",
      "关系类型": "同窗（一同入塾）",
      "原文依据": "然后听宝玉拣的好日子一同入塾。"
    },
    {
      "甲": "宝玉",
      "乙": "宝钗",
      "关系类型": "姐弟（称呼宝兄弟）",
      "原文依据": "宝钗笑道：“宝兄弟，亏你每日家杂学旁收的，难道就不知道酒性最热，要热吃下去，发散的就快；要冷吃下去，便凝结在内。拿五脏去暖他，岂不受害？从此还不改了呢。快别吃那冷的了。”"
    },
    {
      "甲": "宝玉",
      "乙": "黛玉",
      "关系类型": "兄妹（称呼林妹妹）",
      "原文依据": "宝玉还让：“林妹妹喝茶。”"
    },
    {
      "甲": "黛玉",
      "乙": "薛姨妈",
      "关系类型": "姨甥（称姨妈）",
      "原文依据": "黛玉笑道：“姨妈不知道：幸亏是姨妈这里，倘或在别人家，那不叫人家恼吗？难道人家连个手炉也没有，巴巴儿的打家里送了来？不说丫头们太小心，还只当我素日是这么轻狂惯了的呢。”"
    },
    {
      "甲": "宝玉",
      "乙": "袭人",
      "关系类型": "主仆（伏侍）",
      "原文依据": "袭人等便搀至炕上，脱了衣裳，不知宝玉口内还说些什么，只觉口齿缠绵，眉眼愈加饧涩，忙伏侍他睡下。"
    },
    {
      "甲": "宝玉",
      "乙": "晴雯",
      "关系类型": "主仆（听命贴字）",
      "原文依据": "晴雯笑道：“这个人可醉了。你头里过那府里去，嘱咐我贴在门头儿上的。我恐怕别人贴坏了，亲自爬高上梯，贴了半天，这会子还冻的手僵着呢！”"
    },
    {
      "甲": "宝玉",
      "乙": "茜雪",
      "关系类型": "主仆（捧茶）",
      "原文依据": "茜雪捧上茶来。宝玉还让：“林妹妹喝茶。”"
    }
  ]
}