  "关系": [
    {
      "甲": "李贵",
      "乙": "宝玉",
      "关系类型": "劝解",
      "原文依据": "宝玉痛哭不已，李贵等好容易劝解半日方住"
    },
    {
      "甲": "宝玉",
      "乙": "秦钟",
      "关系类型": "痛哭",
      "原文依据": "话说秦钟既死，宝玉痛哭不已"
    },
    {
      "甲": "宝玉",
      "乙": "秦钟",
      "关系类型": "思念",
      "原文依据": "可巧近日宝玉因思念秦钟，忧戚不尽"
    },
    {
      "甲": "贾母",
      "乙": "宝玉",
      "关系类型": "命人带他戏耍",
      "原文依据": "贾母常命人带他到园中来戏耍。"
    },
    {
      "甲": "贾珍",
      "乙": "贾政",
      "关系类型": "回话",
      "原文依据": "这日贾珍等来回贾政"
    },
    {
      "甲": "贾政",
      "乙": "雨村",
      "关系类型": "请来拟",
      "原文依据": "贾政等听了，都道：“所见不差。我们今日且看看去，只管题了，若妥当便用；不妥时，然后将雨村请来，令他再拟。”"
    },
    {
      "甲": "贾珍",
      "乙": "宝玉",
      "关系类型": "告知",
      "原文依据": "忽见贾珍走来，向他笑道：“你还不出去，老爷就来了。”"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "命跟来",
      "原文依据": "贾政近因闻得塾掌称赞宝玉专能对对联，虽不喜读书，偏倒有些歪才情似的，今日偶然撞见这机会，便命他跟来。"
    },
    {
      "甲": "贾珍",
      "乙": "贾政",
      "关系类型": "侍立",
      "原文依据": "贾政刚至园门前，只见贾珍带领许多执事人来，一旁侍立。"
    },
    {
      "甲": "贾政",
      "乙": "贾珍",
      "关系类型": "命关门",
      "原文依据": "贾政道：“你且把园门都关上，我们先瞧了外面再进去。”贾珍听说，命人将门关了。"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "扶",
      "原文依据": "命贾珍在前引导，自己扶了宝玉，逶迤进入山口。"
    },
    {
      "甲": "贾政",
      "乙": "贾珍",
      "关系类型": "命引导",
      "原文依据": "命贾珍在前引导"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "命拟",
      "原文依据": "贾政听了，便回头命宝玉拟来。"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "命作对联",
      "原文依据": "贾政道：“匾上二字容易。再作一副七言对联来。”宝玉听说，立于亭上，四顾一望，便机上心来，乃念道："
    },
    {
      "甲": "贾珍",
      "乙": "宝玉",
      "关系类型": "称宝兄弟",
      "原文依据": "贾珍笑道：“还是宝兄弟拟一个来。”"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "叱骂",
      "原文依据": "贾政点头道：“畜生，畜生，可谓‘管窥蠡测’矣。”因命：“再题一联来。”宝玉便念道："
    },
    {
      "甲": "贾政",
      "乙": "贾琏",
      "关系类型": "唤",
      "原文依据": "贾政听了，便知此事不是贾珍的首尾，便命人去唤贾琏。"
    },
    {
      "甲": "贾政",
      "乙": "贾琏",
      "关系类型": "问",
      "原文依据": "一时，贾琏赶来，贾政问他共有几种，现今得了几种，尚欠几种。"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "喝命",
      "原文依据": "贾政气的喝命：“叉出去，”刚出去，又喝命：“回来！”命再题一联：“若不通，一并打嘴！”宝玉只得念道："
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "喝斥",
      "原文依据": "未及说完，贾政喝道：“谁问你来！”唬的宝玉倒退，不敢再说。"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "喝问",
      "原文依据": "忽抬头见宝玉在旁不敢则声，因喝道：“怎么你应说话时又不说了？还要等人请教你不成！”宝玉听说，便回道："
    },
    {
      "甲": "贾政",
      "乙": "贾母",
      "关系类型": "怕不放心",
      "原文依据": "贾政心中也怕贾母不放心"
    },
    {
      "甲": "贾政",
      "乙": "宝玉",
      "关系类型": "喝命去",
      "原文依据": "贾政忽想起他来，方喝道：“你还不去？难道还逛不足！也不想逛了这半日，老太太必悬挂着。快进去，疼你也白疼了。”宝玉听说，方退了出来。"
    },
    {
      "甲": "贾母",
      "乙": "宝玉",
      "关系类型": "找",
      "原文依据": "前面贾母一片声找宝玉。"
    },
    {
      "甲": "林黛玉",
      "乙": "宝玉",
      "关系类型": "给荷包",
      "原文依据": "林黛玉听说，走来瞧瞧，果然一件无存，因向宝玉道：“我给的那个荷包也给他们了？你明儿再想我的东西，可不能够了！”"
    },
    {
      "甲": "宝玉",
      "乙": "林黛玉",
      "关系类型": "烦作香袋",
      "原文依据": "将前日宝玉所烦他作的那个香袋儿——才做了一半——赌气拿过来就铰。"
    },
    {
      "甲": "宝玉",
      "乙": "林黛玉",
      "关系类型": "称好妹妹",
      "原文依据": "宝玉见他如此，忙回身抢住，笑道：“好妹妹，饶了他罢！”"
    },
    {
      "甲": "宝玉",
      "乙": "林黛玉",
      "关系类型": "请求作香袋",
      "原文依据": "宝玉道：“好妹妹，明儿另替我作个香袋儿罢。”黛玉道：“那也只瞧我高兴罢了。”"
    },
    {
      "甲": "王夫人",
      "乙": "妙玉",
      "关系类型": "下帖子请",
      "原文依据": "王夫人笑道：“他既是官宦小姐，自然骄傲些，就下个帖子请他何妨。”"
    },
    {
      "甲": "林之孝家的",
      "乙": "妙玉",
      "关系类型": "请",
      "原文依据": "林之孝家的答应了出去，命书启相公写请帖去请妙玉。"
    },
    {
      "甲": "王夫人",
      "乙": "林之孝家的",
      "关系类型": "回话",
      "原文依据": "王夫人不等回完，便说：“既这样，我们何不接了他来。”林之孝家的回道：“请他，他说‘侯门公府，必以贵势压人，我再不去的。’”"
    },
    {
      "甲": "妙玉",
      "乙": "师父",
      "关系类型": "随师父",
      "原文依据": "去岁随了师父上来，现在西门外牟尼院住着。他师父极精演先天神数，于去冬圆寂了。"
    },
    {
      "甲": "宝玉",
      "乙": "贾政",
      "关系类型": "称老爷",
      "原文依据": "宝玉听说，连忙回道：“老爷方才所议已是。”"
    },
    {
      "甲": "贾珍",
      "乙": "贾政",
      "关系类型": "称老爷",
      "原文依据": "贾珍笑道：“老爷随我来。从这门出去，便是后院，从后院出去，倒比先近了。”"
    }
  ]
}