  "关系": [
    {
      "甲": "凤姐",
      "乙": "小丫头",
      "关系类型": "吩咐",
      "原文依据": "凤姐听是工部里的事，才把心略略的放下，因说道：“你回去回太太，就说二爷昨日晚上出城有事，没有回来。打发人先回珍大爷去罢。”那丫头答应着去了。"
    },
    {
      "甲": "贾珍",
      "乙": "王夫人",
      "关系类型": "禀报",
      "原文依据": "一时贾珍过来见了部里的人，问明了，进来见了王夫人，回道：“部中来报，昨日总河奏到河南一带决了河口，湮没了几府州县。”"
    },
    {
      "甲": "宝玉",
      "乙": "袭人",
      "关系类型": "主仆",
      "原文依据": "袭人早已打点出一包衣服，向宝玉道：“今日天气很冷，早晚宁使暖些。”说着，把衣服拿出来给宝玉挑了一件穿。"
    },
    {
      "甲": "宝玉",
      "乙": "焙茗",
      "关系类型": "主仆",
      "原文依据": "焙茗道：“二爷穿上罢，着了凉，又是奴才的不是了。二爷只当疼奴才罢。”"
    },
    {
      "甲": "宝玉",
      "乙": "代儒",
      "关系类型": "师生",
      "原文依据": "晚间放学时，宝玉便往代儒托病告假一天。"
    },
    {
      "甲": "宝玉",
      "乙": "晴雯",
      "关系类型": "祭奠",
      "原文依据": "怡红主人焚付晴姐知之，酌茗清香，庶几来飨。"
    },
    {
      "甲": "宝玉",
      "乙": "黛玉",
      "关系类型": "称呼",
      "原文依据": "说着，一径出来，到了潇湘馆中，在院里问道：“林妹妹在家里呢么？”"
    },
    {
      "甲": "黛玉",
      "乙": "紫鹃",
      "关系类型": "主仆",
      "原文依据": "黛玉道：“不写了，收起去罢。”说着，自己走到里间屋里床上歪着，慢慢的细想。紫鹃进来问道：“姑娘喝碗茶罢？”"
    },
    {
      "甲": "黛玉",
      "乙": "雪雁",
      "关系类型": "主仆",
      "原文依据": "因叫雪雁倒茶。"
    },
    {
      "甲": "宝玉",
      "乙": "麝月",
      "关系类型": "主仆",
      "原文依据": "麝月打发宝玉喝了，漱了口。"
    },
    {
      "甲": "宝玉",
      "乙": "秋纹",
      "关系类型": "主仆",
      "原文依据": "只见秋纹走来说道：“那屋里已经收拾妥了，但等着一时炭劲过了，二爷再进去罢。”"
    },
    {
      "甲": "贾母",
      "乙": "黛玉",
      "关系类型": "怜恤",
      "原文依据": "那黛玉虽有贾母王夫人等怜恤，不过请医调治，只说黛玉常病，那里知他的心病。"
    },
    {
      "甲": "王夫人",
      "乙": "黛玉",
      "关系类型": "怜恤",
      "原文依据": "那黛玉虽有贾母王夫人等怜恤，不过请医调治，只说黛玉常病，那里知他的心病。"
    },
    {
      "甲": "薛姨妈",
      "乙": "黛玉",
      "关系类型": "探望",
      "原文依据": "薛姨妈来看，黛玉不见宝钗，越发起疑心"
    },
    {
      "甲": "侍书",
      "乙": "雪雁",
      "关系类型": "告知",
      "原文依据": "雪雁道：“我听见侍书说的，是个什么知府家，家资也好，人才也好。”"
    }
  ]
